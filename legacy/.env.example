DRAS_ENV=development
DRAS_DATABASE_URL=sqlite:///./dras.db
DRAS_STORAGE_DIR=./var/storage
DRAS_API_BASE_URL=http://127.0.0.1:8000
DRAS_SERVICE_TOKEN=change-me
DRAS_ASSESSOR_EMAILS=assessor@example.org
DRAS_OPENAI_API_KEY=
DRAS_EXTRACTION_MODEL=gpt-6-luna
DRAS_REVIEW_MODEL=gpt-6.1-sol
DRAS_REVIEW_REASONING=medium
DRAS_REDIS_URL=redis://redis:6379/0
DRAS_S3_BUCKET=
DRAS_S3_REGION=us-east-1
DRAS_REQUIRE_MALWARE_SCAN=false
DRAS_REQUIRE_PDF_RENDER=false
